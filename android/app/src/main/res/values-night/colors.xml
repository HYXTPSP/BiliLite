<?xml version="1.0" encoding="utf-8"?>
<!--
  BiliLite 深色主题颜色 token（Material Design 3 中性色为主 + 克制主色）
  深色下主色提亮，保证对比度与可读性。
-->
<resources>
    <!-- 中性色（Neutral） -->
    <color name="color_neutral_0">#232327</color>     <!-- surface / 卡片 -->
    <color name="color_neutral_50">#141416</color>    <!-- background / 页面背景 -->
    <color name="color_neutral_100">#2E2E33</color>   <!-- surfaceVariant / 浅灰块 -->
    <color name="color_neutral_200">#3A3A40</color>   <!-- 分割线 / 占位 -->
    <color name="color_neutral_300">#4A4A52</color>   <!-- outline / 边框 -->
    <color name="color_neutral_600">#BDC1C6</color>   <!-- onSurfaceVariant / 次文字(≥4.5:1) -->
    <color name="color_neutral_700">#C5C5CA</color>   <!-- 正文 -->
    <color name="color_neutral_900">#E8E8EA</color>   <!-- onSurface / 主文字 -->

    <!-- 主色（Primary，仅关键操作/选中态） -->
    <color name="color_primary">#8AB4F8</color>
    <color name="color_on_primary">#0A1B4D</color>
    <color name="color_primary_container">#1E3A6E</color>
    <color name="color_on_primary_container">#D6E4FF</color>

    <!-- 已看徽章 -->
    <color name="color_watched_bg">#1B3A26</color>
    <color name="color_watched_fg">#6FCE8C</color>

    <!-- 强调/警示 -->
    <color name="color_error">#F2B8B5</color>
    <color name="color_warn">#FFD54F</color>
</resources>
